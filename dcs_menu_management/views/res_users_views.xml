<odoo>
    <!-- User form (administrators) -->
    <record id="dcs_view_users_form" model="ir.ui.view">
        <field name="name">res.users.form.dcs.menu</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='preferences']" position="after">
                <page string="Menu Management" name="dcs_menu_visibility" invisible="share"
                      groups="base.group_system,dcs_menu_management.group_menu_manager">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button name="action_dcs_open_app_order" type="object" string="Application Order"
                                icon="fa-sort" class="btn-secondary"/>
                        <button name="action_dcs_copy_menu_settings" type="object"
                                string="Copy Menu Settings to Other Users" icon="fa-clone" class="btn-secondary"/>
                        <button name="action_dcs_reset_personal_menus" type="object" string="Reset Personal Menus"
                                icon="fa-undo" class="btn-secondary" invisible="not dcs_personal_hidden_menu_ids"
                                confirm="Show again every menu this user hid personally?"/>
                    </div>
                    <group>
                        <group string="Hidden Menus">
                            <field name="dcs_hidden_menu_ids" widget="many2many_tags" nolabel="1" colspan="2"
                                   context="{'ir.ui.menu.full_list': True}" options="{'no_create': True}"
                                   placeholder="Choose menus to hide for this user..."/>
                            <div class="text-muted small" colspan="2">
                                Saved as "Hide for Users" on each menu, so it also shows in Menu Configuration.
                            </div>
                        </group>
                        <group string="Options">
                            <field name="dcs_allow_menu_preferences" widget="boolean_toggle"/>
                            <field name="dcs_show_favorites" widget="boolean_toggle"/>
                            <field name="dcs_show_recent" widget="boolean_toggle"/>
                            <field name="dcs_app_order_count" string="Personal App Order"
                                   invisible="not dcs_app_order_count"/>
                        </group>
                    </group>
                    <group>
                        <group string="Favorite Menus" invisible="not dcs_show_favorites">
                            <field name="dcs_favorite_menu_ids" widget="many2many_tags" nolabel="1" colspan="2"
                                   context="{'ir.ui.menu.full_list': True}" options="{'no_create': True}"
                                   placeholder="Add favorite menus..."/>
                        </group>
                        <group string="Personally Hidden Menus" invisible="not dcs_allow_menu_preferences">
                            <field name="dcs_personal_hidden_menu_ids" widget="many2many_tags" nolabel="1" colspan="2"
                                   context="{'ir.ui.menu.full_list': True}" options="{'no_create': True}"
                                   placeholder="None"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- My Preferences (the user themself) -->
    <record id="dcs_view_users_form_simple_modif" model="ir.ui.view">
        <field name="name">res.users.preferences.dcs.menu</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="My Menus" name="dcs_my_menus"
                      invisible="not dcs_allow_menu_preferences and not dcs_show_favorites">
                    <field name="dcs_allow_menu_preferences" invisible="1"/>
                    <field name="dcs_show_favorites" invisible="1"/>
                    <p class="text-muted">
                        Personalise your own menu bar. This does not change what you are allowed to do in Odoo.
                    </p>
                    <div class="d-flex flex-wrap gap-2 mb-3" invisible="not dcs_allow_menu_preferences">
                        <button name="action_dcs_open_personal_menus" type="object" string="Choose Menus to Hide"
                                icon="fa-list-ul" class="btn-primary"/>
                        <button name="action_dcs_open_app_order" type="object" string="Reorder My Apps"
                                icon="fa-sort" class="btn-secondary"/>
                    </div>
                    <group>
                        <field name="dcs_personal_hidden_menu_ids" widget="many2many_tags" readonly="0"
                               string="Hidden Menus" options="{'no_create': True}"
                               placeholder="No hidden menu" invisible="not dcs_allow_menu_preferences"/>
                        <field name="dcs_favorite_menu_ids" widget="many2many_tags" readonly="0"
                               string="Favorite Menus" options="{'no_create': True}"
                               placeholder="Use the star in the top bar to add the menu you are on"
                               invisible="not dcs_show_favorites"/>
                    </group>
                    <p class="text-muted small">Changes to these lists apply when you reload the page.</p>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Users allowed to hide menus personally -->
    <record id="dcs_view_users_list_personal" model="ir.ui.view">
        <field name="name">res.users.list.dcs.personal</field>
        <field name="model">res.users</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="User Menu Settings" editable="bottom" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="login" readonly="1"/>
                <field name="company_id" readonly="1" groups="base.group_multi_company" optional="show"/>
                <field name="dcs_allow_menu_preferences" widget="boolean_toggle"/>
                <field name="dcs_show_favorites" widget="boolean_toggle"/>
                <field name="dcs_show_recent" widget="boolean_toggle"/>
                <field name="dcs_personal_hidden_menu_ids" widget="many2many_tags" readonly="1"
                       context="{'ir.ui.menu.full_list': True}" optional="show"/>
                <field name="dcs_favorite_menu_ids" widget="many2many_tags" readonly="1"
                       context="{'ir.ui.menu.full_list': True}" optional="hide"/>
                <button name="action_dcs_reset_personal_menus" type="object" icon="fa-undo"
                        title="Reset personal menus" invisible="not dcs_personal_hidden_menu_ids"/>
            </list>
        </field>
    </record>

    <record id="dcs_view_users_search_personal" model="ir.ui.view">
        <field name="name">res.users.search.dcs.personal</field>
        <field name="model">res.users</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('login', 'ilike', self)]"/>
                <field name="dcs_personal_hidden_menu_ids" string="Hidden Menu"/>
                <filter name="filter_allowed" string="Allowed" domain="[('dcs_allow_menu_preferences', '=', True)]"/>
                <filter name="filter_not_allowed" string="Not Allowed" domain="[('dcs_allow_menu_preferences', '=', False)]"/>
                <filter name="filter_hiding" string="Hiding Menus" domain="[('dcs_personal_hidden_menu_ids', '!=', False)]"/>
                <filter name="filter_favorites" string="Favorites Enabled" domain="[('dcs_show_favorites', '=', True)]"/>
                <filter name="filter_recent" string="Recent Menus Enabled" domain="[('dcs_show_recent', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_dcs_personal_users" model="ir.actions.act_window">
        <field name="name">User Menu Settings</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list</field>
        <field name="domain">[('share', '=', False)]</field>
        <field name="context">{'ir.ui.menu.full_list': True}</field>
        <field name="search_view_id" ref="dcs_view_users_search_personal"/>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('dcs_view_users_list_personal')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No internal user</p>
            <p>Switch on <strong>Hide Menus Through Preferences</strong>, <strong>Favorite Menus</strong> or
               <strong>Recent Menus</strong> for each user.</p>
        </field>
    </record>
</odoo>
