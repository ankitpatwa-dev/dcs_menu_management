<odoo>
    <record id="res_groups_privilege_menu_management" model="res.groups.privilege">
        <field name="name">Menu Management</field>
        <field name="description">Configure who sees which menus (Advanced Menu Management by DevsCodeSpace).</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

    <!-- Standard Odoo groups are not modified: Settings administrators are
         recognised through base.group_system directly in code, ACLs and menus. -->
    <record id="group_menu_manager" model="res.groups">
        <field name="name">Menu Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_menu_management"/>
        <field name="comment">Can configure menu visibility rules and personal menu permissions. Settings administrators always have this right. The user also needs access to the Settings app (Administration: Access Rights) to reach the Menu Management menu.</field>
    </record>

    <!-- Wizards: each user only sees their own records -->
    <record id="rule_dcs_menu_personal_wizard_own" model="ir.rule">
        <field name="name">My Menus wizard: own records</field>
        <field name="model_id" ref="model_dcs_menu_personal_wizard"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="rule_dcs_menu_personal_wizard_line_own" model="ir.rule">
        <field name="name">My Menus wizard lines: own records</field>
        <field name="model_id" ref="model_dcs_menu_personal_wizard_line"/>
        <field name="domain_force">[('wizard_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <!-- Application order: users read the global order and their own, and
         change only their own (the model also requires the permission) -->
    <record id="rule_dcs_menu_sequence_user_read" model="ir.rule">
        <field name="name">Application order: read own and global</field>
        <field name="model_id" ref="model_dcs_menu_sequence"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_dcs_menu_sequence_user_write" model="ir.rule">
        <field name="name">Application order: change own</field>
        <field name="model_id" ref="model_dcs_menu_sequence"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_dcs_menu_sequence_manager" model="ir.rule">
        <field name="name">Application order: administrators</field>
        <field name="model_id" ref="model_dcs_menu_sequence"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_system')), Command.link(ref('group_menu_manager'))]"/>
    </record>

    <!-- Recent menus are private: every user, administrators included, only sees their own -->
    <record id="rule_dcs_menu_recent_own" model="ir.rule">
        <field name="name">Recent menus: own records only</field>
        <field name="model_id" ref="model_dcs_menu_recent"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <!-- Order wizard -->
    <record id="rule_dcs_menu_order_wizard_own" model="ir.rule">
        <field name="name">Application order wizard: own records</field>
        <field name="model_id" ref="model_dcs_menu_order_wizard"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="rule_dcs_menu_order_wizard_line_own" model="ir.rule">
        <field name="name">Application order wizard lines: own records</field>
        <field name="model_id" ref="model_dcs_menu_order_wizard_line"/>
        <field name="domain_force">[('wizard_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
</odoo>
