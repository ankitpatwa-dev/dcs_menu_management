<odoo>
    <record id="dcs_menu_personal_wizard_view_form" model="ir.ui.view">
        <field name="name">dcs.menu.personal.wizard.form</field>
        <field name="model">dcs.menu.personal.wizard</field>
        <field name="arch" type="xml">
            <form string="My Menus">
                <field name="user_id" invisible="1"/>
                <p class="text-muted">
                    Switch on the menus you want to hide. Hiding a menu also hides its sub-menus.
                    Your administrator's settings and your access rights are not affected.
                    <span class="badge text-bg-secondary ms-1"><field name="hidden_count"/> hidden</span>
                </p>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="sequence" column_invisible="True"/>
                        <field name="menu_id" column_invisible="True" force_save="1"/>
                        <field name="app_name"/>
                        <field name="menu_path"/>
                        <field name="hidden" widget="boolean_toggle"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Save and Reload" class="btn-primary"
                            data-hotkey="q"/>
                    <button name="action_show_all" type="object" string="Show All" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
